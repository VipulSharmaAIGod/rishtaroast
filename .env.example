# ============================================================================
# API web service env (server.js). Copy to .env for local dev. NEVER commit .env.
# The STATIC SITE does not read this file: it is configured via public/config.js
# (or Render static-site env vars API_BASE_URL, SITE_URL, UPI_ID, ... applied by scripts/configure-static.js).
# ============================================================================
PORT=3000
BRAND_NAME=RishtaRoast
# Comma-separated browser origins allowed to call the API (your static site URL(s)). No trailing slash.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Number of proxy hops to trust for client IP (1 = Render)
TRUST_PROXY=1

# ---- AI (optional! app works fully without it using templates) ----
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1                              AI_MODEL=gpt-4o-mini
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=<current Gemini Flash model>
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=<a current small Llama model>
# (Model names change often - check the provider docs.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.95
AI_TIMEOUT_MS=9000
AI_JSON_MODE=true
AI_ENABLED=true

# ---- Cost controls ----
AI_PER_IP_HOUR=5
AI_PER_IP_DAY=20
AI_PRO_PER_IP_DAY=60
AI_GLOBAL_DAILY_CAP=500
REQUESTS_PER_IP_HOUR=60
CACHE_TTL_HOURS=24
CACHE_MAX_ENTRIES=5000

# ---- Tips (informational for /api/config only; the site uses public/config.js) ----
UPI_ID=PLACEHOLDER@upi
UPI_PAYEE_NAME=RishtaRoast
UPI_DEFAULT_AMOUNT=29
RAZORPAY_TIP_LINK=https://rzp.io/l/PLACEHOLDER

# ---- Pro / HD (Razorpay checkout is a STUB until keys are set) ----
PRO_ENABLED=true
PRO_PRICE_INR=29
PRO_VALIDITY_DAYS=30
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRO_TOKEN_SECRET=change-me-to-a-long-random-string
# Local testing only - lets you unlock Pro without paying. Forced off when NODE_ENV=production.
PRO_DEMO_UNLOCK=false
